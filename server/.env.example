PORT=4000
MONGO_URI=mongodb://localhost:27017/codelings
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change-me
# Where the React app runs (used for CORS and links in emails). Comma-separate several.
CLIENT_URL=http://localhost:5173

# Secret for the external scheduler URL /api/cron/run?key=... (needed on free hosts that sleep)
CRON_SECRET=

# Weekly leagues run Monday 00:00 to Sunday 23:59 in this timezone
LEAGUE_TIMEZONE=Africa/Lagos

# Your admin login, created by `npm run seed:admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@codelings.local
ADMIN_PASSWORD=change-me-please

# --- Email ---
# Development: Mailpit from docker-compose (view emails at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Codelings <hello@codelings.local>"

# Production on a host that blocks SMTP (e.g. Render's free plan): use Brevo's API instead.
# Create a free account at brevo.com, verify your sender address, then create an API key.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Codelings <yourname@gmail.com>   (must be the address you verified in Brevo; no quotes needed)

# Production with Gmail SMTP (no domain needed, but needs a host that allows SMTP):
# 1. Turn on 2-Step Verification on the Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM="Codelings <yourname@gmail.com>"
